{
  "name": "study-material",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "figures": "node scripts/render-figures.mjs",
    "validate": "node scripts/validate.mjs",
    "upload": "node --env-file=.env scripts/upload.mjs",
    "scrape": "node scripts/scrape.mjs",
    "mark-terms": "node scripts/mark-terms.mjs",
    "deploy": "npm run build && node --env-file=.env scripts/firebase.mjs deploy --only hosting,firestore:rules",
    "firebase": "node --env-file=.env scripts/firebase.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "firebase": "13.1.0",
    "katex": "0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "an-array-of-english-words": "2.0.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.2",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
